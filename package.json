{
  "name": "dash-isometric",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "bridge"
  ],
  "scripts": {
    "dev": "concurrently -n bridge,client -c blue,green \"npm run dev -w bridge\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w bridge",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
