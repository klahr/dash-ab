# Copy to bridge/.env (git-ignored). Real environment variables take precedence.

# --- Mode -------------------------------------------------------------------
# MOCK=1 runs the built-in simulator (4 runners, moving tasks, canned chat).
# Left unset, the bridge uses the simulator only when no Dash server is configured.
# MOCK=0 forces a real connection (startup fails if it can't connect).
# MOCK=1
# MOCK_TICK_MS=1500

# --- WebSocket server for the browser ---------------------------------------
# BRIDGE_PORT=8787

# --- Dash MCP server: URL (streamable HTTP, falling back to SSE) --------------
# Dash serves MCP at /mcp on its public URL (OAuth, for claude.ai) and gives
# runners a per-task endpoint; point this at an endpoint that accepts a bearer token.
# DASH_MCP_URL=http://127.0.0.1:7788/mcp
# DASH_MCP_TOKEN=
# auto (default) | http | sse | stdio
# DASH_MCP_TRANSPORT=auto

# --- ...or Dash MCP server: stdio command ------------------------------------
# DASH_MCP_COMMAND=/path/to/dash-mcp
# Space-separated, or a JSON array if arguments contain spaces.
# DASH_MCP_ARGS=["--flag", "value with spaces"]

# --- Polling & mapping -------------------------------------------------------
# DASH_POLL_MS=3000
# DASH_ORG_NAME=Dash
# Only show these projects (comma-separated ids or names). Also used as the
# project list when the server has no list_projects tool.
# DASH_PROJECTS=

# Override the tool used for a role if your server names it differently.
# DASH_TOOL_PROJECTS=list_projects
# DASH_TOOL_TASKS=list_todos
# DASH_TOOL_GOALS=list_goals
# DASH_TOOL_RUNNERS=
# DASH_TOOL_CHAT=
